# nginx reverse proxy for the training API server.
# Replace training.zozac.com.au with your hostname, and the certbot paths after
# running: sudo certbot --nginx -d training.zozac.com.au

upstream training_api {
    server 127.0.0.1:8080;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name training.zozac.com.au;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name training.zozac.com.au;

    ssl_certificate     /etc/letsencrypt/live/training.zozac.com.au/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/training.zozac.com.au/privkey.pem;

    # generous, because a participant may paste a large dataset into the console
    client_max_body_size 8m;

    # ---- the console -------------------------------------------------------
    # Uncomment to keep /admin on your own network only. The participant API at
    # /t/ stays public. This is worth doing: the console can create instances,
    # read every key and delete data.
    #
    # location /admin {
    #     allow 203.0.113.0/24;      # your office / VPN range
    #     allow 198.51.100.7;        # your home address
    #     deny all;
    #     proxy_pass http://training_api;
    #     include /etc/nginx/proxy_params;
    # }

    location / {
        proxy_pass http://training_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_read_timeout 60s;
    }
}
